# ==========================================================================
# 诺诺 —— 配置模板。复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交到仓库。
# ==========================================================================

# ────────────────────────────── 驱动 / 服务 ──────────────────────────────
# fastapi 提供反向 WS 服务端；httpx 供插件请求校园系统；websockets 供 QQ 官方适配器连网关
DRIVER=~fastapi+~httpx+~websockets
# HOST 必须是 0.0.0.0：容器内要接受 NapCat 经 compose 网络访问（镜像里已内置该默认值）
HOST=0.0.0.0
# 改 PORT 时无需再改映射（compose 用 ${PORT}），NapCat 的 ONEBOT_URL 也会跟随
PORT=8080
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ────────────────────────────── 适配器开关 ──────────────────────────────
# 本地直接 `uv run python bot.py` 也会读取本文件（bot.py 用 dotenv 解析）
ENABLE_ONEBOT_V11=true
ENABLE_QQ_OFFICIAL=false

# ────────────────────── OneBot V11（NapCat 反向 WS）──────────────────────
# NapCat 侧自动生成：ws://bot:8080/onebot/v11/ws （容器内服务名用 bot）
# 若 NapCat 配了 token，这里填同一个值；不配就都留空
ONEBOT_ACCESS_TOKEN=

# ──────────────────── QQ 官方机器人（ENABLE_QQ_OFFICIAL=true）────────────────────
# use_websocket=true 走长连接，无需公网回调地址；改为 false 则需公网 webhook
QQ_BOTS=[{"id":"你的AppID","secret":"你的AppSecret","use_websocket":true,"intent":{"at_messages":true,"direct_message":true}}]
QQ_IS_SANDBOX=false

# ────────────────────────── SUES 插件配置（可选覆盖）──────────────────────────
SUES_BASE_URL=https://epay.sues.edu.cn
ELECTRICITY_PRICE_PER_KWH=0.617
# 以下两项一般无需修改；如学校更换密钥再覆盖（8 字节）
# DES_KEY=
# DES_IV=

# 插件数据目录：镜像里已固定 LOCALSTORE_DATA_DIR=/app/data（对应 ./data 卷），无需设置。
# 仅本地开发想让数据落在仓库 ./data 时，取消下一行注释：
# LOCALSTORE_USE_CWD=true

# ────────────────────────── docker compose 部署变量 ──────────────────────────
# 服务器上拉取的镜像地址；首次部署前确认 owner/仓库名
IMAGE=ghcr.io/noel-psc/nuonuo:latest
# 若使用 ACR，可改成：IMAGE=registry.cn-hangzhou.aliyuncs.com/你的命名空间/nuonuo:latest
BOT_BIND=127.0.0.1

# NapCat sidecar（docker compose --profile napcat 时生效）
# 仅首次启动时用于初始化 WebUI 登录令牌（webui.json 已存在则不覆盖）
# ⚠️ 必须改成随机值，例如：openssl rand -hex 16
# compose 里写的是 ${NAPCAT_WEBUI_TOKEN:?...}，留空会直接报错
NAPCAT_WEBUI_TOKEN=请改成随机字符串
NAPCAT_UID=1000
NAPCAT_GID=1000
